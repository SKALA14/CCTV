# infra/.env — docker-compose 변수 치환용. 아래 값을 채워 infra/.env 로 복사해 사용하세요.
# DB·Redis·스트림 이름·포트·CAMERA_ID 등은 docker-compose.yaml에 고정값으로 설정되어 있습니다.

# === OpenAI (필수) ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# === 인증 ===
# 최초 기동 시 superadmin 계정이 자동 시드됩니다.
# admin·viewer 계정은 로그인 후 관리(AdminView) 페이지에서 현장별로 생성합니다.
AUTH_SECRET=여기에-32자-이상-무작위-문자열          # 필수 — JWT 서명 키 (운영 시 반드시 변경)
SUPERADMIN_USERNAME=superadmin                       # 슈퍼관리자 아이디 (기본 superadmin)
SUPERADMIN_PASSWORD=강한패스워드!                    # 필수 — 슈퍼관리자 비밀번호
JWT_EXPIRE_HOURS=8                                    # 토큰 유효 시간 (시간)
COOKIE_SECURE=false                                  # 운영 HTTPS 환경에서는 true

# === 알림 (선택) ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# === 인증 (운영 시 반드시 변경) ===
AUTH_SECRET=여기에-32자-이상-무작위-문자열
ADMIN_USERNAME=admin
ADMIN_PASSWORD=강한패스워드!
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=뷰어패스워드!
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=false
